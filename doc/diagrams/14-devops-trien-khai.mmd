flowchart TB
    BROWSER(("Trình duyệt<br/>(trên máy host)"))
    CLI["dcm4che CLI<br/>storescu / echoscu<br/>(trên máy host)"]

    subgraph HOST["Máy host (localhost) — Docker Desktop"]
        BROWSER
        CLI
