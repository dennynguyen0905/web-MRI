        DB --- PVC_DB
        SVC_PACS --> PACS
        PACS --- PVC_PACS
        SVC_OHIF --> OHIF
        SVC_HIS -.-> HIS
        BE -.->|"H-03, [HOÃN]"| SVC_HIS

        CM1 -.->|"envFrom"| BE
        CM1 -.->|"envFrom"| FE
        CM1 -.->|"mount orthanc.json"| PACS
        SEC1 -.->|"envFrom"| BE
        SEC1 -.->|"envFrom"| DB
    end

    BROWSER -- "http://localhost:8080<br/>(duy nhất người dùng RIS cần biết)" --> SVC_FE
    BROWSER -. "http://localhost:8043<br/>deep-link StudyInstanceUID, IN-19/IN-23" .-> SVC_OHIF
    BROWSER -. "http://localhost:8042/dicom-web<br/>gọi từ JS của OHIF, KHÔNG qua backend" .-> SVC_PACS
    CLI -. "localhost:4242, C-STORE" .-> SVC_PACS

