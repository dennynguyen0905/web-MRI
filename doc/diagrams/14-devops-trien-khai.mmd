    subgraph K8S["Cụm Kubernetes local (Docker Desktop) — namespace \"vr-ris\""]
        subgraph FE_D["Deployment ris-frontend"]
            FE["Pod: nginx + React build<br/>:80"]
        end
        SVC_FE["Service ris-frontend<br/>type LoadBalancer :8080"]

        subgraph BE_D["Deployment ris-backend"]
            BE["Pod: Spring Boot<br/>:8080, context /api/v1<br/>profile k8s - tu chay Flyway"]
        end
        SVC_BE["Service ris-backend<br/>type ClusterIP :8080"]

        subgraph DB_S["StatefulSet mysql"]
            DB[("Pod: mysql:8.4<br/>:3306")]
        end
        SVC_DB["Service mysql<br/>headless (ClusterIP: None)"]
        PVC_DB[("PVC data<br/>2Gi, StorageClass hostpath")]

        subgraph PACS_S["StatefulSet orthanc — tuần 7, IN-19"]
            PACS[("Pod: Orthanc 26.9.1<br/>:4242 DICOM, :8042 HTTP/DICOMweb")]
        end
        SVC_PACS["Service orthanc<br/>type LoadBalancer :4242, :8042"]
        PVC_PACS[("PVC data<br/>5Gi")]

        subgraph OHIF_D["Deployment ohif-viewer — tuần 7, IN-19"]
            OHIF["Pod: OHIF Viewer<br/>:80"]
        end
        SVC_OHIF["Service ohif-viewer<br/>type LoadBalancer :8043"]

        subgraph HIS_D["Deployment mock-his — H-03, [HOÃN], replicas=0"]
            HIS["Pod: chưa có image thật"]
        end
        SVC_HIS["Service mock-his<br/>type ClusterIP :2575 (MLLP)"]

        CM1["ConfigMap backend-config<br/>mysql-config, frontend-config, orthanc-config"]
        SEC1["Secret backend-secret, mysql-secret<br/>⚠️ base64, không phải mã hóa"]

        SVC_FE --> FE
        FE -- "proxy /api (nginx)" --> SVC_BE
        SVC_BE --> BE
        BE -- "JDBC :3306" --> SVC_DB
