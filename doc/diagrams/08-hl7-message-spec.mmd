    HIS->>RIS: ORM^O01 (ORC-1=CA, MSH-10=M2)
    RIS->>RIS: study đã có study_instance_uid
    RIS-->>HIS: ACK (AR, echo M2) + ERR
    end

    rect rgb(240, 255, 240)
